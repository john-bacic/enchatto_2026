        <img src="/icons/o-shootingstar.png" alt="🌠" draggable="false" class="ec-icon" style="width:78%;height:78%"/>
       </button>
       <button style="position:relative;aspect-ratio:1;display:grid;place-items:center;padding:0;border:2.5px solid var(--ink);border-radius:12px;background:var(--yellow);box-shadow:0 3px 0 var(--ink);cursor:default;overflow:visible">
