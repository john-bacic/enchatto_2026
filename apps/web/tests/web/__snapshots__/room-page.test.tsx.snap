markup
<div class="ec-room" style="--chat-scale:1;--me-tint:#e2f1ff">
 <div class="ec-paper" style="--tex-img:url(texture doodles);--tex-size:160px;--blob-a:rgba(255, 122, 182, .18);--blob-b:rgba(59, 107, 255, .13)" aria-hidden="true"></div>
 <header class="ec-chat-head">
  <button aria-label="Display settings" style="flex:none;padding:0;border:0;background:none;cursor:pointer;border-radius:50%">
   <span style="display:inline-grid;place-items:center;flex:none;width:40px;height:40px;border-radius:50%;border:3px solid var(--ink);background:#cfe8ff;box-shadow:0 3px 0 var(--ink);overflow:hidden">
    <img src="/icons/av-whale.png" alt="Whale" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
   </span>
  </button>
  <div class="ec-chat-title">
   <h1>
    <div class="ec-wordmark" style="--fs:22px">
     <div class="ec-logo-top" role="img" aria-label="Enchatto">
      <i data-c="E" style="--r:-7deg;--dy:0px;--d:0s;--i:0;--c:#3b6bff">E</i>
      <i data-c="n" style="--r:6deg;--dy:-5px;--d:-0.18s;--i:1;--c:#ff7ab6">n</i>
      <i data-c="c" style="--r:-7deg;--dy:0px;--d:-0.36s;--i:2;--c:#3fdcb0">c</i>
      <i data-c="h" style="--r:6deg;--dy:-5px;--d:-0.54s;--i:3;--c:#a77bff">h</i>
      <i data-c="a" style="--r:-7deg;--dy:0px;--d:-0.72s;--i:4;--c:#3b6bff">a</i>
      <i data-c="t" style="--r:6deg;--dy:-5px;--d:-0.8999999999999999s;--i:5;--c:#ff7ab6">t</i>
      <i data-c="t" style="--r:-7deg;--dy:0px;--d:-1.08s;--i:6;--c:#3fdcb0">t</i>
      <i data-c="o" style="--r:6deg;--dy:-5px;--d:-1.26s;--i:7;--c:#a77bff">o</i>
     </div>
    </div>
   </h1>
   <span>
    <i class="ec-online-dot"></i>
    3 online, 1 away
   </span>
  </div>
  <button type="button" class="ec-vibe" aria-expanded="false" aria-label="VIBE 0">
   <small>VIBE</small>
   <b>0</b>
  </button>
  <button class="ec-stack" aria-label="In this room 3" aria-haspopup="dialog">
   <span class="ec-stack-av">
    <span style="display:inline-grid;place-items:center;flex:none;width:30px;height:30px;border-radius:50%;border:2.5px solid var(--ink);background:#fde68a;overflow:hidden">
     <img src="/icons/av-hamster.png" alt="Hamster" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
    </span>
    <span class="ec-presence-dot online"></span>
   </span>
   <span class="ec-stack-av">
    <span style="display:inline-grid;place-items:center;flex:none;width:30px;height:30px;border-radius:50%;border:2.5px solid var(--ink);background:#d9e4ff;overflow:hidden">
     <img src="/icons/av-cat.png" alt="Cat" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
    </span>
    <span class="ec-presence-dot online"></span>
   </span>
   <span class="ec-stack-av">
    <span style="display:inline-grid;place-items:center;flex:none;width:30px;height:30px;border-radius:50%;border:2.5px solid var(--ink);background:#d9e4ff;overflow:hidden;opacity:0.75">
     <img src="/icons/av-ghost.png" alt="Ghost" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
    </span>
    <span class="ec-presence-dot away"></span>
   </span>
  </button>
 </header>
 <div class="ec-stage">
  <div class="ec-messages">
   <div class="ec-sys">
    <span style="display:inline-grid;place-items:center;flex:none;width:22px;height:22px;border-radius:50%;border:1.5px solid var(--ink);background:#d9e4ff;overflow:hidden">
     <img src="/icons/av-cat.png" alt="Cat" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
    </span>
    <span>Yuki has joined</span>
   </div>
   <div class="ec-sys">
    <span style="display:inline-grid;place-items:center;flex:none;width:22px;height:22px;border-radius:50%;border:1.5px solid var(--ink);background:#cfe8ff;overflow:hidden">
     <img src="/icons/av-whale.png" alt="Whale" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
    </span>
    <span>Sam has joined</span>
   </div>
   <div class="ec-msg">
    <div class="ec-msg-row">
     <div class="ec-who">
      <span style="display:inline-grid;place-items:center;flex:none;width:36px;height:36px;border-radius:50%;border:2.5px solid var(--ink);background:#fde68a;box-shadow:0 3px 0 var(--ink);overflow:hidden">
       <img src="/icons/av-hamster.png" alt="Hamster" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
      </span>
      <small>Alex</small>
     </div>
     <div class="ec-bubble-col">
      <div class="ec-bubble" style="--bubble-tint:#fef0b9">
       <p>Hello everyone!</p>
       <div class="ec-tr">
        <p class="ec-romaji" style="margin:0 0 2px">minasan, konnichiwa!</p>
        <p>
         <span class="ec-tr-tag">JA</span>
         みなさん、こんにちは！
        </p>
       </div>
      </div>
      <div class="ec-reacts">
       <button class="ec-react mine">
        <span class="ec-react-in">
         <img src="/icons/re-thumbs.png" alt="👍" draggable="false" class="ec-icon" style="width:18px;height:18px"/>
         <b>2</b>
        </span>
       </button>
       <button class="ec-react mine">
        <span class="ec-react-in">
         <img src="/icons/re-star.png" alt="🔥" draggable="false" class="ec-icon" style="width:18px;height:18px"/>
        </span>
       </button>
      </div>
     </div>
     <button class="ec-react-add" title="React or reply">
      <img src="/icons/re-heart.png" alt="" draggable="false" class="ec-icon" style="width:16px;height:16px"/>
     </button>
    </div>
    <div style="margin-left:50px">
     <div class="ec-chips">
      <button style="--c:var(--pink-soft);animation-delay:0s">こんにちは！</button>
      <button style="--c:var(--blue-soft);animation-delay:0.06s">よろしくね</button>
     </div>
    </div>
   </div>
   <div class="ec-msg">
    <div style="margin-left:50px;max-width:80%">
     <div class="ec-reply" style="margin-bottom:4px">
      <span style="display:inline-grid;place-items:center;flex:none;width:20px;height:20px;border-radius:50%;border:1.5px solid var(--ink);background:#fde68a;overflow:hidden">
       <img src="/icons/av-hamster.png" alt="Hamster" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
      </span>
      <span>
       <b>Alex: </b>
       <span style="font-style:normal">Hello everyone!</span>
      </span>
     </div>
    </div>
    <div class="ec-msg-row">
     <div class="ec-who">
      <span style="display:inline-grid;place-items:center;flex:none;width:36px;height:36px;border-radius:50%;border:2.5px solid var(--ink);background:#d9e4ff;box-shadow:0 3px 0 var(--ink);overflow:hidden">
       <img src="/icons/av-cat.png" alt="Cat" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
      </span>
      <small>Yuki</small>
     </div>
     <div class="ec-bubble-col">
      <div class="ec-bubble" style="--bubble-tint:#e8efff">
       <p>Nice to meet you</p>
       <div class="ec-tr">
        <p class="ec-romaji" style="margin:0 0 2px">hajimemashite</p>
        <p>
         <span class="ec-tr-tag">JA</span>
         はじめまして
        </p>
       </div>
      </div>
     </div>
     <button class="ec-react-add" title="React or reply">
      <img src="/icons/re-heart.png" alt="" draggable="false" class="ec-icon" style="width:16px;height:16px"/>
     </button>
    </div>
   </div>
   <div class="ec-msg own">
    <div class="ec-msg-row">
     <div class="ec-bubble-col">
      <div class="ec-bubble failed">
       <p>Where is everyone from?</p>
       <div class="ec-status-line" style="color:var(--red)">
        <img src="/icons/g-bang.png" alt="" draggable="false" class="ec-icon" style="width:16px;height:16px"/>
        Translation failed
       </div>
      </div>
     </div>
    </div>
   </div>
   <div class="ec-msg own">
    <div class="ec-msg-row">
     <div class="ec-bubble-col">
      <div class="ec-bubble media">
       <div class="ec-media">
        <div class="ec-media-loading">
         <span class="ec-dots">
          <i></i>
          <i></i>
          <i></i>
         </span>
        </div>
        <img src="https://example.convex.cloud/api/storage/photo" alt="Shared image" style="display:none"/>
       </div>
      </div>
     </div>
    </div>
   </div>
   <div class="ec-msg">
    <div class="ec-msg-row">
     <div class="ec-who">
      <span style="display:inline-grid;place-items:center;flex:none;width:36px;height:36px;border-radius:50%;border:2.5px solid var(--ink);background:#d9e4ff;box-shadow:0 3px 0 var(--ink);overflow:hidden">
       <img src="/icons/av-cat.png" alt="Cat" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
      </span>
      <small>Yuki</small>
     </div>
     <div class="ec-bubble-col">
      <div class="ec-bubble media" style="--bubble-tint:#e8efff">
       <div class="ec-media drawing">
        <img src="https://example.convex.cloud/api/storage/drawing" alt="Drawing"/>
       </div>
      </div>
     </div>
     <button class="ec-react-add" title="React or reply">
      <img src="/icons/re-heart.png" alt="" draggable="false" class="ec-icon" style="width:16px;height:16px"/>
     </button>
    </div>
   </div>
   <div class="ec-msg own">
    <div class="ec-msg-row">
     <div class="ec-bubble-col">
      <div class="ec-bubble">
       <div class="ec-vm">
        <button type="button" class="ec-vm-play" aria-label="Play">
         <svg viewBox="0 0 10 12" aria-hidden="true" class="tri">
          <path d="M0 0l10 6-10 6z"></path>
         </svg>
        </button>
        <div class="ec-vm-wave" role="presentation">
         <i style="height:6px"></i>
         <i style="height:15px"></i>
         <i style="height:24px"></i>
         <i style="height:13px"></i>
        </div>
        <span class="ec-vm-meta">
         <span>0:03</span>
         <select class="ec-vm-speed" aria-label="Playback speed">
          <option value="0.5">0.5×</option>
          <option value="0.75">0.75×</option>
          <option value="1" selected="">1×</option>
          <option value="1.5">1.5×</option>
          <option value="2">2×</option>
         </select>
        </span>
       </div>
       <button type="button" class="ec-vm-show" aria-expanded="false">
        <svg viewBox="0 0 10 10" aria-hidden="true">
         <path d="M2 3.5l3 3 3-3"></path>
        </svg>
        Show text
       </button>
      </div>
     </div>
    </div>
   </div>
   <div class="ec-sys">
    <span style="display:inline-grid;place-items:center;flex:none;width:22px;height:22px;border-radius:50%;border:1.5px solid var(--ink);background:#e5e7eb;overflow:hidden">
     <img src="/icons/av-panda.png" alt="Panda" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
    </span>
    <span>Mika has joined</span>
   </div>
   <div class="ec-sys">
    <span style="display:inline-grid;place-items:center;flex:none;width:22px;height:22px;border-radius:50%;border:1.5px solid var(--ink);background:#e5e7eb;overflow:hidden">
     <img src="/icons/av-panda.png" alt="Panda" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
    </span>
    <span>Mika has left</span>
   </div>
   <div class="ec-msg">
    <div class="ec-msg-row">
     <div class="ec-who">
      <span style="display:inline-grid;place-items:center;flex:none;width:36px;height:36px;border-radius:50%;border:2.5px solid var(--ink);background:#d9e4ff;box-shadow:0 3px 0 var(--ink);overflow:hidden">
       <img src="/icons/av-cat.png" alt="Cat" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
      </span>
      <small>Yuki</small>
     </div>
     <div class="ec-bubble-col">
      <div class="ec-bubble pending" style="--bubble-tint:#e8efff">
       <p>みんなはどこから来ましたか？</p>
       <div class="ec-status-line">
        translating
        <span class="ec-dots">
         <i></i>
         <i></i>
         <i></i>
        </span>
       </div>
      </div>
     </div>
     <button class="ec-react-add" title="React or reply">
      <img src="/icons/re-heart.png" alt="" draggable="false" class="ec-icon" style="width:16px;height:16px"/>
     </button>
    </div>
   </div>
   <div style="flex:none;height:4px"></div>
  </div>
 </div>
 <div class="ec-inputbar">
  <div class="ec-input-row">
   <div class="ec-tools">
    <button class="ec-round-btn game" aria-label="Games">
     <img src="/icons/ui-game.png" alt="" draggable="false" class="ec-icon" style="width:26px;height:26px"/>
    </button>
    <button class="ec-round-btn draw" aria-label="Drawing">
     <img src="/icons/g-pencil.png" alt="" draggable="false" class="ec-icon" style="width:24px;height:24px"/>
    </button>
    <button class="ec-round-btn photo" aria-label="Photo">
     <img src="/icons/ui-camera.png" alt="" draggable="false" class="ec-icon" style="width:24px;height:24px"/>
    </button>
   </div>
   <input type="file" accept="image/*" style="display:none"/>
   <button type="button" class="ec-tools-toggle" aria-label="More tools" aria-hidden="true" tabindex="-1">
    <svg viewBox="0 0 10 16" aria-hidden="true">
     <path d="M2.5 2l5.5 6-5.5 6"></path>
    </svg>
   </button>
   <div class="ec-text-pill">
    <textarea placeholder="Type a message..." rows="1"></textarea>
   </div>
   <button class="ec-round-btn send" disabled="" aria-label="Send">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
     <path d="M12 20V5" stroke="currentColor" stroke-width="3.4" stroke-linecap="round"></path>
     <path d="M5.5 11.5L12 5l6.5 6.5" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
   </button>
  </div>
 </div>
 <div style="position:fixed;top:76px;right:max(12px, calc(50% - 248px));z-index:150;display:flex;flex-direction:column;gap:8px;align-items:flex-end;pointer-events:none"></div>
</div>"
`;

exports[`the chat > the same conversation for the host 1`] = `
