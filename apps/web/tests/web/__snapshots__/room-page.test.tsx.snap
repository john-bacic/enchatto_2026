  wordRush:cancel
  wordRush:cancel
  wordRush:createLobby
  wordRush:joinLobby
  wordRush:leaveLobby
  wordRush:start
  wordRush:updateSettings
markup
<div class="ec-room" style="--chat-scale:1;--me-tint:#e8efff">
 <div class="ec-paper" style="--tex-img:url(texture doodles);--tex-size:160px;--blob-a:rgba(255, 122, 182, .18);--blob-b:rgba(59, 107, 255, .13)" aria-hidden="true"></div>
 <header class="ec-chat-head">
  <button aria-label="表示設定" style="flex:none;padding:0;border:0;background:none;cursor:pointer;border-radius:50%">
   <span style="display:inline-grid;place-items:center;flex:none;width:40px;height:40px;border-radius:50%;border:3px solid var(--ink);background:#d9e4ff;box-shadow:0 3px 0 var(--ink);overflow:hidden">
    <img src="/icons/av-cat.png" alt="Cat" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
   </span>
  </button>
  <div class="ec-chat-title">
   <h1>
    <div class="ec-wordmark" style="--fs:22px">
     <div class="ec-logo-top" role="img" aria-label="Enchatto">
      <i data-c="E" style="--r:-7deg;--dy:0px;--d:0s;--i:0;--c:#3b6bff">E</i>
      <i data-c="n" style="--r:6deg;--dy:-5px;--d:-0.18s;--i:1;--c:#ff7ab6">n</i>
      <i data-c="c" style="--r:-7deg;--dy:0px;--d:-0.36s;--i:2;--c:#3fdcb0">c</i>
      <i data-c="h" style="--r:6deg;--dy:-5px;--d:-0.54s;--i:3;--c:#a77bff">h</i>
      <i data-c="a" style="--r:-7deg;--dy:0px;--d:-0.72s;--i:4;--c:#3b6bff">a</i>
      <i data-c="t" style="--r:6deg;--dy:-5px;--d:-0.8999999999999999s;--i:5;--c:#ff7ab6">t</i>
      <i data-c="t" style="--r:-7deg;--dy:0px;--d:-1.08s;--i:6;--c:#3fdcb0">t</i>
      <i data-c="o" style="--r:6deg;--dy:-5px;--d:-1.26s;--i:7;--c:#a77bff">o</i>
     </div>
    </div>
   </h1>
   <span>
    <i class="ec-online-dot"></i>
    3 オンライン
   </span>
  </div>
  <button type="button" class="ec-vibe" aria-expanded="false" aria-label="VIBE 0">
   <small>VIBE</small>
   <b>0</b>
  </button>
  <button class="ec-stack" aria-label="このルームのメンバー 2" aria-haspopup="dialog">
   <span class="ec-stack-av">
    <span style="display:inline-grid;place-items:center;flex:none;width:30px;height:30px;border-radius:50%;border:2.5px solid var(--ink);background:#fde68a;overflow:hidden">
     <img src="/icons/av-hamster.png" alt="Hamster" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
    </span>
    <span class="ec-presence-dot online"></span>
   </span>
   <span class="ec-stack-av">
    <span style="display:inline-grid;place-items:center;flex:none;width:30px;height:30px;border-radius:50%;border:2.5px solid var(--ink);background:#cfe8ff;overflow:hidden">
     <img src="/icons/av-whale.png" alt="Whale" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
    </span>
    <span class="ec-presence-dot online"></span>
   </span>
  </button>
 </header>
 <div style="position:relative;z-index:5;display:flex;flex-direction:column;gap:7px;padding:8px 12px 9px;background:var(--paper);border-bottom:3px solid var(--ink);box-shadow:0 3px 0 rgba(29, 27, 79, 0.12)">
  <div style="display:flex;align-items:center;gap:8px">
   <span class="ec-chunky" style="display:inline-flex;align-items:center;gap:4px;flex:none;padding:1px 9px 1px 3px;border:2.5px solid var(--ink);border-radius:999px;background:var(--violet-soft);font-size:11px">
    <img src="/icons/g-pencil.png" alt="" draggable="false" class="ec-icon" style="width:20px;height:20px"/>
    レベル 1
   </span>
   <div style="flex:1;display:flex;gap:3px">
    <i style="flex:1;height:9px;border:2px solid var(--ink);border-radius:6px;background:var(--yellow);animation:ec-pulse 0.9s ease-in-out infinite"></i>
    <i style="flex:1;height:9px;border:2px solid var(--ink);border-radius:6px;background:#fff"></i>
    <i style="flex:1;height:9px;border:2px solid var(--ink);border-radius:6px;background:#fff"></i>
    <i style="flex:1;height:9px;border:2px solid var(--ink);border-radius:6px;background:#fff"></i>
    <i style="flex:1;height:9px;border:2px solid var(--ink);border-radius:6px;background:#fff"></i>
    <i style="flex:1;height:9px;border:2px solid var(--ink);border-radius:6px;background:#fff"></i>
    <i style="flex:1;height:9px;border:2px solid var(--ink);border-radius:6px;background:#fff"></i>
    <i style="flex:1;height:9px;border:2px solid var(--ink);border-radius:6px;background:#fff"></i>
    <i style="flex:1;height:9px;border:2px solid var(--ink);border-radius:6px;background:#fff"></i>
    <i style="flex:1;height:9px;border:2px solid var(--ink);border-radius:6px;background:#fff"></i>
   </div>
   <span class="ec-chunky" style="flex:none;font-size:16px;line-height:1">
    1
    <small style="font-size:11px;opacity:0.5">/10</small>
   </span>
  </div>
  <div style="display:flex;align-items:center;gap:8px;min-width:0">
   <div style="display:flex;align-items:center;gap:6px;flex:1;min-width:0;padding:2px 10px 2px 2px;border:2.5px solid var(--ink);border-radius:999px;background:var(--blue-soft);box-shadow:0 2px 0 var(--ink);overflow:hidden;position:relative">
    <span aria-hidden="true" style="position:absolute;inset:0;width:0%;background:var(--mint-soft);transition:width 0.4s ease"></span>
    <span style="display:inline-grid;place-items:center;flex:none;width:24px;height:24px;border-radius:50%;border:2px solid var(--ink);background:#fde68a;overflow:hidden;position:relative">
     <img src="/icons/av-hamster.png" alt="Hamster" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
    </span>
    <span style="position:relative;flex:1;min-width:0;font-size:12px;font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">推測中... (0/2)</span>
   </div>
   <div style="display:flex;align-items:center;gap:4px;flex:none">
    <div title="Alex: 0/0" style="display:flex;align-items:center;gap:3px;padding:1px 7px 1px 1px;border:2px solid var(--ink);border-radius:999px;background:#fff">
     <span style="display:inline-grid;place-items:center;flex:none;width:20px;height:20px;border-radius:50%;border:1.5px solid var(--ink);background:#fde68a;overflow:hidden">
      <img src="/icons/av-hamster.png" alt="Hamster" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
     </span>
     <span class="ec-chunky" style="font-size:12px">0</span>
    </div>
    <div title="Yuki: 0/0" style="display:flex;align-items:center;gap:3px;padding:1px 7px 1px 1px;border:2px solid var(--ink);border-radius:999px;background:#fff">
     <span style="display:inline-grid;place-items:center;flex:none;width:20px;height:20px;border-radius:50%;border:1.5px solid var(--ink);background:#d9e4ff;overflow:hidden">
      <img src="/icons/av-cat.png" alt="Cat" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
     </span>
     <span class="ec-chunky" style="font-size:12px">0</span>
    </div>
    <div title="Sam: 0/0" style="display:flex;align-items:center;gap:3px;padding:1px 7px 1px 1px;border:2px solid var(--ink);border-radius:999px;background:#fff">
     <span style="display:inline-grid;place-items:center;flex:none;width:20px;height:20px;border-radius:50%;border:1.5px solid var(--ink);background:#cfe8ff;overflow:hidden">
      <img src="/icons/av-whale.png" alt="Whale" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
     </span>
     <span class="ec-chunky" style="font-size:12px">0</span>
    </div>
   </div>
  </div>
 </div>
 <div class="ec-stage">
  <div class="ec-messages">
   <div class="ec-sys">
    <span style="display:inline-grid;place-items:center;flex:none;width:22px;height:22px;border-radius:50%;border:1.5px solid var(--ink);background:#d9e4ff;overflow:hidden">
     <img src="/icons/av-cat.png" alt="Cat" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
    </span>
    <span>Yukiが参加しました</span>
   </div>
   <div class="ec-sys">
    <span style="display:inline-grid;place-items:center;flex:none;width:22px;height:22px;border-radius:50%;border:1.5px solid var(--ink);background:#cfe8ff;overflow:hidden">
     <img src="/icons/av-whale.png" alt="Whale" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
    </span>
    <span>Samが参加しました</span>
   </div>
   <div class="ec-sys">
    <img src="/icons/g-question.png" alt="" draggable="false" class="ec-icon" style="width:18px;height:18px"/>
    <span>ゲーム開始：どっちする？</span>
   </div>
   <div class="ec-sys">
    <img src="/icons/g-pencil.png" alt="" draggable="false" class="ec-icon" style="width:18px;height:18px"/>
    <span>ゲーム開始：ロスト・イン・トランスレーション — レベル 1</span>
   </div>
   <div class="ec-msg">
    <div class="ec-msg-row">
     <div class="ec-who">
      <span style="display:inline-grid;place-items:center;flex:none;width:36px;height:36px;border-radius:50%;border:2.5px solid var(--ink);background:#fde68a;box-shadow:0 3px 0 var(--ink);overflow:hidden">
       <img src="/icons/av-hamster.png" alt="Hamster" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
      </span>
      <small>Alex</small>
     </div>
     <div class="ec-bubble-col">
      <div class="ec-bubble media" style="--bubble-tint:#fef0b9">
       <div class="ec-media drawing">
        <img src="https://example.convex.cloud/api/storage/round-1" alt="Drawing"/>
       </div>
      </div>
     </div>
     <button class="ec-react-add" title="リアクションまたは返信">
      <img src="/icons/re-heart.png" alt="" draggable="false" class="ec-icon" style="width:16px;height:16px"/>
     </button>
    </div>
   </div>
   <div style="flex:none;height:4px"></div>
  </div>
 </div>
 <div class="ec-inputbar">
  <div class="ec-input-row">
   <div class="ec-tools">
    <button class="ec-round-btn game" aria-label="ゲーム">
     <img src="/icons/ui-game.png" alt="" draggable="false" class="ec-icon" style="width:26px;height:26px"/>
    </button>
    <button class="ec-round-btn draw" aria-label="お絵描き">
     <img src="/icons/g-pencil.png" alt="" draggable="false" class="ec-icon" style="width:24px;height:24px"/>
    </button>
    <button class="ec-round-btn photo" aria-label="写真">
     <img src="/icons/ui-camera.png" alt="" draggable="false" class="ec-icon" style="width:24px;height:24px"/>
    </button>
   </div>
   <input type="file" accept="image/*" style="display:none"/>
   <button type="button" class="ec-tools-toggle" aria-label="ツール" aria-hidden="true" tabindex="-1">
    <svg viewBox="0 0 10 16" aria-hidden="true">
     <path d="M2.5 2l5.5 6-5.5 6"></path>
    </svg>
   </button>
   <div class="ec-text-pill">
    <textarea placeholder="メッセージを入力…" rows="1"></textarea>
   </div>
   <button class="ec-round-btn send" disabled="" aria-label="送信">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
     <path d="M12 20V5" stroke="currentColor" stroke-width="3.4" stroke-linecap="round"></path>
     <path d="M5.5 11.5L12 5l6.5 6.5" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
   </button>
  </div>
 </div>
 <div class="ec-sheet-backdrop" style="z-index:120">
  <div class="ec-sheet wr-sheet" role="dialog" aria-label="ワードラッシュ">
   <div class="grab"></div>
   <div style="display:flex;align-items:center;justify-content:center;gap:10px">
    <span style="font-size:40px;line-height:1;animation:ec-hop 1.6s cubic-bezier(.3,1.6,.5,1) infinite;--r:-6deg">🌸</span>
    <div class="wr-sheet-title">ワードラッシュ</div>
   </div>
   <p style="text-align:center;font-size:13px;font-weight:900;opacity:0.7;margin-top:6px">3つの絵文字から単語を当てて、覚えて、言ってみよう！</p>
   <div class="wr-dir">
    <span>日本語の人 → English</span>
    <span>English speakers → 日本語</span>
   </div>
   <div style="margin-top:16px">
    <div class="ec-label">単語パック</div>
    <div class="wr-packs">
     <button type="button" class="on" disabled="">
      <img src="/icons/ui-sparkle.png" alt="" draggable="false" class="ec-icon" style="width:22px;height:22px"/>
      ミックス
     </button>
     <button type="button" class="" disabled="">
      <img src="/icons/o-cake.png" alt="" draggable="false" class="ec-icon" style="width:22px;height:22px"/>
      グルメ
     </button>
     <button type="button" class="" disabled="">
      <img src="/icons/o-train.png" alt="" draggable="false" class="ec-icon" style="width:22px;height:22px"/>
      旅行
     </button>
     <button type="button" class="" disabled="">
      <img src="/icons/re-laugh.png" alt="" draggable="false" class="ec-icon" style="width:22px;height:22px"/>
      スラング
     </button>
     <button type="button" class="" disabled="">
      <img src="/icons/o-shootingstar.png" alt="" draggable="false" class="ec-icon" style="width:22px;height:22px"/>
      アニメ
     </button>
     <button type="button" class="" disabled="">
      <img src="/icons/re-heart.png" alt="" draggable="false" class="ec-icon" style="width:22px;height:22px"/>
      気持ち
     </button>
     <button type="button" class=" chat" disabled="">
      <img src="/icons/ui-chat.png" alt="" draggable="false" class="ec-icon" style="width:22px;height:22px"/>
      このチャットから
     </button>
    </div>
    <div class="wr-shimmer ready" style="margin-top:10px">
     <img src="/icons/g-ok.png" alt="" draggable="false" class="ec-icon" style="width:20px;height:20px"/>
     新しいカードの準備OK！
    </div>
   </div>
   <div style="margin-top:14px">
    <button type="button" class="wr-toggle" disabled="" style="cursor:default">
     <img src="/icons/g-music.png" alt="" draggable="false" class="ec-icon" style="width:36px;height:36px"/>
     <span class="txt">
      言ってみよう！
      <small>2問ごとに誰かがマイクで発音チャレンジ</small>
     </span>
     <span class="ec-chip outline">OFF</span>
    </button>
   </div>
   <div style="margin-top:16px">
    <div class="ec-label">
     2人
     <small>
      <span class="ec-lang-badge" style="width:16px;height:16px;font-size:8px">A</span>
       / 
      <span class="ec-lang-badge" style="width:16px;height:16px;font-size:8px">あ</span>
       = 学習中
     </small>
    </div>
    <div class="wr-players">
     <span class="wr-player" style="animation-delay:0s">
      <span style="display:inline-grid;place-items:center;flex:none;width:30px;height:30px;border-radius:50%;border:2px solid var(--ink);background:#fde68a;overflow:hidden">
       <img src="/icons/av-hamster.png" alt="Hamster" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
      </span>
      Alex
      <img src="/icons/g-crown.png" alt="ホスト" draggable="false" class="ec-icon" style="width:18px;height:18px"/>
      <span class="ec-lang-badge" style="width:22px;height:22px;font-size:11px">あ</span>
     </span>
     <span class="wr-player me" style="animation-delay:0.04s">
      <span style="display:inline-grid;place-items:center;flex:none;width:30px;height:30px;border-radius:50%;border:2px solid var(--ink);background:#d9e4ff;overflow:hidden">
       <img src="/icons/av-cat.png" alt="Cat" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
      </span>
      Yuki
      <span class="ec-lang-badge" style="width:22px;height:22px;font-size:11px">A</span>
     </span>
    </div>
   </div>
   <div style="display:flex;flex-direction:column;gap:12px;margin-top:20px">
    <div class="ec-card" style="padding:12px 14px;display:flex;align-items:center;justify-content:center;gap:10px;font-weight:900;font-size:14px;box-shadow:0 4px 0 var(--ink)">
     <span class="ec-dots">
      <i></i>
      <i></i>
      <i></i>
     </span>
     ホストの開始を待っています…
    </div>
    <div style="display:flex;gap:10px">
     <button type="button" class="ec-btn white sm">最小化</button>
     <button type="button" class="ec-btn white sm">抜ける</button>
    </div>
   </div>
  </div>
 </div>
 <div class="ec-sheet-backdrop" style="z-index:95;align-items:center;padding:16px">
  <div class="ec-card" style="width:100%;max-width:360px;max-height:90dvh;overflow-y:auto;padding:22px 18px 18px;text-align:center;background:var(--paper);animation:ec-pop 0.4s cubic-bezier(0.3, 1.6, 0.5, 1)">
   <img src="/icons/o-cherry.png" alt="" draggable="false" class="ec-icon" style="width:64px;height:64px;animation:ec-drop-in 0.6s cubic-bezier(0.3, 1.6, 0.5, 1)"/>
   <h2 class="ec-chunky" style="font-size:24px;margin:4px 0;text-shadow:0 3px 0 var(--violet)">Emoji Match</h2>
   <p style="font-size:12.5px;font-weight:700;opacity:0.75;margin-bottom:14px;line-height:1.45">Match English and Japanese words! Flip cards to pair translations.</p>
   <div style="padding:8px 10px;margin-bottom:16px;border:2.5px solid var(--ink);border-radius:16px;background:#fff;max-height:200px;overflow-y:auto;text-align:left">
    <div style="font-size:11px;font-weight:900;opacity:0.6;margin-bottom:6px">Players (2/30)</div>
    <div style="display:flex;flex-wrap:wrap;gap:6px">
     <span style="display:inline-flex;align-items:center;gap:5px;padding:2px 10px 2px 2px;border:2px solid var(--ink);border-radius:999px;background:var(--violet-soft);font-size:12.5px;font-weight:900;animation:ec-pop 0.35s cubic-bezier(0.3, 1.6, 0.5, 1)">
      <span style="display:inline-grid;place-items:center;flex:none;width:24px;height:24px;border-radius:50%;border:2px solid var(--ink);background:#fde68a;overflow:hidden">
       <img src="/icons/av-hamster.png" alt="Hamster" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
      </span>
      Alex
      <span class="ec-chunky" style="font-size:9px;color:var(--violet)">HOST</span>
     </span>
     <span style="display:inline-flex;align-items:center;gap:5px;padding:2px 10px 2px 2px;border:2px solid var(--ink);border-radius:999px;background:var(--paper);font-size:12.5px;font-weight:900;animation:ec-pop 0.35s cubic-bezier(0.3, 1.6, 0.5, 1)">
      <span style="display:inline-grid;place-items:center;flex:none;width:24px;height:24px;border-radius:50%;border:2px solid var(--ink);background:#d9e4ff;overflow:hidden">
       <img src="/icons/av-cat.png" alt="Cat" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
      </span>
      Yuki
     </span>
    </div>
   </div>
   <div style="display:flex;flex-direction:column;gap:10px">
    <button class="ec-btn white" style="font-size:17px">ロビーを出る</button>
   </div>
  </div>
 </div>
 <div class="ec-sheet-backdrop" style="z-index:95;align-items:center;padding:16px">
  <div class="ec-card" style="width:100%;max-width:360px;max-height:90dvh;overflow-y:auto;padding:22px 18px 18px;text-align:center;background:var(--paper);animation:ec-pop 0.4s cubic-bezier(0.3, 1.6, 0.5, 1)">
   <img src="/icons/g-clover.png" alt="" draggable="false" class="ec-icon" style="width:64px;height:64px;animation:ec-drop-in 0.6s cubic-bezier(0.3, 1.6, 0.5, 1)"/>
   <h2 class="ec-chunky" style="font-size:24px;margin:4px 0 4px;text-shadow:0 3px 0 var(--mint)">絵文字ビンゴ</h2>
   <p style="font-size:12.5px;font-weight:700;opacity:0.75;margin-bottom:14px;line-height:1.45">呼ばれた絵文字をカードにマーク。パターンを最初に完成させた人の勝ち！</p>
   <div style="padding:8px 10px;margin-bottom:16px;border:2.5px solid var(--ink);border-radius:16px;background:#fff;max-height:150px;overflow-y:auto;text-align:left">
    <div style="font-size:11px;font-weight:900;opacity:0.6;margin-bottom:6px">2 人のプレイヤー</div>
    <div style="display:flex;flex-wrap:wrap;gap:6px">
     <span style="display:inline-flex;align-items:center;gap:5px;padding:2px 10px 2px 2px;border:2px solid var(--ink);border-radius:999px;background:var(--yellow-soft);font-size:12.5px;font-weight:900;animation:ec-pop 0.35s cubic-bezier(0.3, 1.6, 0.5, 1)">
      <span style="display:inline-grid;place-items:center;flex:none;width:24px;height:24px;border-radius:50%;border:2px solid var(--ink);background:#fde68a;overflow:hidden">
       <img src="/icons/av-hamster.png" alt="Hamster" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
      </span>
      Alex
      <span style="font-size:10px;opacity:0.6">(ホスト)</span>
     </span>
     <span style="display:inline-flex;align-items:center;gap:5px;padding:2px 10px 2px 2px;border:2px solid var(--ink);border-radius:999px;background:var(--paper);font-size:12.5px;font-weight:900;animation:ec-pop 0.35s cubic-bezier(0.3, 1.6, 0.5, 1)">
      <span style="display:inline-grid;place-items:center;flex:none;width:24px;height:24px;border-radius:50%;border:2px solid var(--ink);background:#d9e4ff;overflow:hidden">
       <img src="/icons/av-cat.png" alt="Cat" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
      </span>
      Yuki
     </span>
    </div>
   </div>
   <button class="ec-btn white" style="font-size:17px">ロビーを出る</button>
  </div>
 </div>
 <div style="position:fixed;inset:0;padding-bottom:0;background:var(--paper);color:var(--ink);z-index:200;display:flex;flex-direction:column;align-items:center;overflow:hidden;isolation:isolate;transition:padding-bottom 0.15s ease-out">
  <style>
@keyframes tod-l { 0%, 100% { transform: rotate(-6deg); } 50% { transform: rotate(-9deg) translateY(-8px); } }
@keyframes tod-r { 0%, 100% { transform: rotate(6deg); } 50% { transform: rotate(9deg) translateY(-8px); } }
.tod-card { transition: transform 0.08s, box-shadow 0.08s; }
.tod-card:active:not(:disabled) { transform: translateY(6px) rotate(var(--tod-r)) !important; box-shadow: 0 3px 0 var(--ink) !important; animation: none !important; }
</style>
  <div class="ec-rays" aria-hidden="true"></div>
  <div class="ec-rays-glow" aria-hidden="true"></div>
  <div style="width:100%;max-width:520px;padding:max(10px, env(safe-area-inset-top)) 14px 8px;display:flex;align-items:center;gap:8px">
   <button class="ec-round-btn" aria-label="最小化" title="最小化" style="width:40px;height:40px;font-family:var(--chunky);font-size:18px;box-shadow:0 3px 0 var(--ink)">–</button>
   <span class="ec-chunky" style="display:inline-flex;align-items:center;gap:6px;padding:3px 12px 3px 6px;border:2.5px solid var(--ink);border-radius:999px;background:#fff;box-shadow:0 3px 0 var(--ink);font-size:13px;white-space:nowrap;text-transform:uppercase">
    <img src="/icons/g-question.png" alt="" draggable="false" class="ec-icon" style="width:24px;height:24px"/>
    どっちする？
   </span>
  </div>
  <div style="display:flex;align-items:center;justify-content:center;gap:6px;flex:none">
   <span style="display:inline-flex;align-items:center;gap:3px;padding:3px 12px;border:2.5px solid var(--ink);border-radius:999px;background:var(--ink);color:var(--yellow);font-size:12px;font-weight:900;white-space:nowrap">ノーマル</span>
   <span style="padding:3px 12px;border:2.5px solid var(--ink);border-radius:999px;background:#fff;font-size:12px;font-weight:900;white-space:nowrap">ターン 1/10</span>
  </div>
  <div style="flex:1;min-height:0;display:flex;flex-direction:column;padding:6px 16px 12px;width:100%;max-width:420px;overflow-y:auto;-webkit-overflow-scrolling:touch">
   <div style="display:flex;flex-direction:column;gap:14px;flex:1">
    <div style="display:flex;flex-direction:column;align-items:center;gap:16px;margin:auto 0">
     <div class="ec-chunky" style="display:flex;align-items:center;gap:10px;max-width:100%;padding:6px 18px 6px 6px;border:3.5px solid var(--ink);border-radius:999px;background:var(--yellow);box-shadow:0 5px 0 var(--ink);font-size:19px;animation:ec-pop-in 0.45s cubic-bezier(0.3, 1.6, 0.5, 1) both">
      <span style="display:inline-grid;place-items:center;flex:none;width:46px;height:46px;border-radius:50%;border:3px solid var(--ink);background:#d9e4ff;overflow:hidden">
       <img src="/icons/av-cat.png" alt="Cat" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
      </span>
      <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">あなたの番です！</span>
     </div>
     <div style="position:relative;display:flex;justify-content:center;gap:14px;margin-top:6px">
      <button class="tod-card" style="--tod-r:-6deg;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;width:150px;height:220px;padding:0 6px;border:4px solid var(--ink);border-radius:28px;box-shadow:0 9px 0 var(--ink);background:radial-gradient(circle, rgba(255, 255, 255, 0.25) 0 3px, transparent 3.5px) 0 0 / 18px 18px, var(--blue);color:#fff;font-family:var(--chunky);font-size:19px;white-space:nowrap;line-height:1.1;text-shadow:var(--outline3), 0 5px 0 var(--ink);text-transform:uppercase;transform:rotate(-6deg);animation:tod-l 1.6s ease-in-out infinite;cursor:pointer;opacity:1">
       <img src="/icons/g-question.png" alt="" draggable="false" class="ec-icon" style="width:90px;height:90px;filter:drop-shadow(0 4px 0 rgba(29, 27, 79, 0.6))"/>
       ほんとのこと
       <span style="font-family:var(--round);font-size:14px;font-weight:900;text-transform:none">TRUTH</span>
      </button>
      <span class="ec-chunky" style="position:absolute;left:50%;top:50%;z-index:2;transform:translate(-50%, -50%) rotate(-8deg);display:grid;place-items:center;width:58px;height:58px;border:3.5px solid var(--ink);border-radius:50%;background:var(--yellow);box-shadow:0 4px 0 var(--ink);font-size:19px;pointer-events:none">OR</span>
      <button class="tod-card" style="--tod-r:6deg;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;width:150px;height:220px;padding:0 6px;border:4px solid var(--ink);border-radius:28px;box-shadow:0 9px 0 var(--ink);background:repeating-linear-gradient(-45deg, rgba(255, 255, 255, 0.18) 0 12px, transparent 12px 24px), var(--pink);color:#fff;font-family:var(--chunky);font-size:19px;white-space:nowrap;line-height:1.1;text-shadow:var(--outline3), 0 5px 0 var(--ink);text-transform:uppercase;transform:rotate(6deg);animation:tod-r 1.6s ease-in-out infinite;cursor:pointer;opacity:1">
       <img src="/icons/g-bang.png" alt="" draggable="false" class="ec-icon" style="width:90px;height:90px;filter:drop-shadow(0 4px 0 rgba(29, 27, 79, 0.6))"/>
       チャレンジ
       <span style="font-family:var(--round);font-size:14px;font-weight:900;text-transform:none">DARE</span>
      </button>
     </div>
     <div style="font-size:13.5px;font-weight:900;opacity:0.65;text-align:center;display:flex;align-items:center;gap:4px;margin-top:8px">
      みんなが答えを1〜5で評価するよ 
      <img src="/icons/o-star.png" alt="" draggable="false" class="ec-icon" style="width:18px;height:18px"/>
     </div>
     <button style="align-self:center;padding:5px 16px;border:2.5px solid var(--ink);border-radius:999px;background:#fff;box-shadow:0 3px 0 var(--ink);font-size:13px;font-weight:900;color:var(--ink);cursor:pointer">スキップ</button>
    </div>
   </div>
  </div>
  <div style="display:flex;gap:10px;padding:14px 16px max(12px, env(safe-area-inset-bottom));margin-top:-8px;overflow-x:auto;width:100%;max-width:520px;justify-content:safe center;flex:none">
   <div style="position:relative;display:flex;flex-direction:column;align-items:center;gap:2px;flex:none;width:56px;padding-top:2px">
    <span style="display:inline-grid;place-items:center;flex:none;width:48px;height:48px;border-radius:50%;border:3px solid var(--ink);background:#d9e4ff;box-shadow:0 3px 0 var(--ink), 0 0 0 3px var(--yellow);overflow:hidden;opacity:1;animation:ec-bob 1.6s ease-in-out 2">
     <img src="/icons/av-cat.png" alt="Cat" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
    </span>
    <span style="max-width:100%;padding:0 6px;border-radius:999px;background:var(--ink);color:var(--yellow);font-size:10.5px;font-weight:900;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Yuki</span>
   </div>
   <div style="position:relative;display:flex;flex-direction:column;align-items:center;gap:2px;flex:none;width:56px;padding-top:2px">
    <span style="display:inline-grid;place-items:center;flex:none;width:40px;height:40px;border-radius:50%;border:3px solid var(--ink);background:#cfe8ff;overflow:hidden;opacity:0.75">
     <img src="/icons/av-whale.png" alt="Whale" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
    </span>
    <span style="max-width:100%;padding:0;border-radius:999px;background:transparent;color:var(--ink);font-size:10.5px;font-weight:900;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Sam</span>
   </div>
   <div style="position:relative;display:flex;flex-direction:column;align-items:center;gap:2px;flex:none;width:56px;padding-top:2px">
    <span style="display:inline-grid;place-items:center;flex:none;width:40px;height:40px;border-radius:50%;border:3px solid var(--ink);background:#fde68a;overflow:hidden;opacity:0.75">
     <img src="/icons/av-hamster.png" alt="Hamster" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
    </span>
    <span style="max-width:100%;padding:0;border-radius:999px;background:transparent;color:var(--ink);font-size:10.5px;font-weight:900;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Alex</span>
   </div>
  </div>
 </div>
 <div style="position:fixed;top:76px;right:max(12px, calc(50% - 248px));z-index:150;display:flex;flex-direction:column;gap:8px;align-items:flex-end;pointer-events:none"></div>
 <div style="position:fixed;inset:0;z-index:60;display:flex;flex-direction:column;max-width:600px;margin:0 auto;width:100%;background:repeating-linear-gradient(-45deg, rgba(167, 123, 255, 0.09) 0 14px, transparent 14px 28px), var(--paper)">
  <div style="display:flex;align-items:center;gap:10px;padding:12px 14px 8px">
   <button class="ec-round-btn" aria-label="やめる" style="width:40px;height:40px;font-size:16px;box-shadow:0 3px 0 var(--ink)">✕</button>
   <div style="flex:1;display:flex;gap:4px">
    <i style="flex:1;height:10px;border:2px solid var(--ink);border-radius:6px;background:var(--yellow);animation:ec-pulse 0.8s ease-in-out infinite"></i>
    <i style="flex:1;height:10px;border:2px solid var(--ink);border-radius:6px;background:#fff"></i>
    <i style="flex:1;height:10px;border:2px solid var(--ink);border-radius:6px;background:#fff"></i>
    <i style="flex:1;height:10px;border:2px solid var(--ink);border-radius:6px;background:#fff"></i>
    <i style="flex:1;height:10px;border:2px solid var(--ink);border-radius:6px;background:#fff"></i>
    <i style="flex:1;height:10px;border:2px solid var(--ink);border-radius:6px;background:#fff"></i>
    <i style="flex:1;height:10px;border:2px solid var(--ink);border-radius:6px;background:#fff"></i>
    <i style="flex:1;height:10px;border:2px solid var(--ink);border-radius:6px;background:#fff"></i>
    <i style="flex:1;height:10px;border:2px solid var(--ink);border-radius:6px;background:#fff"></i>
    <i style="flex:1;height:10px;border:2px solid var(--ink);border-radius:6px;background:#fff"></i>
   </div>
   <div class="ec-chunky" style="font-size:20px;white-space:nowrap" aria-label="ラウンド 1 / 10">
    1
    <small style="font-size:13px;opacity:0.5">/10</small>
   </div>
  </div>
  <div style="flex:1;overflow:auto;padding:4px 16px 24px;display:flex;flex-direction:column;gap:14px">
   <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
    <span class="ec-chunky" style="display:inline-flex;align-items:center;gap:6px;min-width:0;padding:3px 12px 3px 6px;border:2.5px solid var(--ink);border-radius:999px;background:#fff;box-shadow:0 3px 0 var(--ink);font-size:11px;white-space:nowrap;overflow:hidden">
     <img src="/icons/g-pencil.png" alt="" draggable="false" class="ec-icon" style="width:24px;height:24px"/>
     ロスト・イン・トランスレーション
    </span>
    <span style="flex:none;padding:2px 10px;border:2.5px solid var(--ink);border-radius:999px;background:var(--violet-soft);font-size:11px;font-weight:900;white-space:nowrap">LV 1</span>
   </div>
   <div class="ec-card" style="margin-top:12px;padding:10px;border-radius:24px">
    <span class="ec-chunky" style="position:absolute;z-index:2;left:50%;top:-18px;transform:translateX(-50%) rotate(-2deg);display:inline-flex;align-items:center;gap:6px;padding:3px 12px 3px 6px;border:2.5px solid var(--ink);border-radius:999px;background:var(--yellow);box-shadow:0 3px 0 var(--ink);font-size:13px;white-space:nowrap">
     <img src="/icons/g-question.png" alt="" draggable="false" class="ec-icon" style="width:24px;height:24px"/>
     この絵は何ですか？
    </span>
    <div style="border:2.5px dashed var(--line-soft);border-radius:16px;overflow:hidden;background:#fffdf8">
     <img src="https://example.convex.cloud/api/storage/round-1" alt="Drawing to guess" style="width:100%;display:block"/>
    </div>
   </div>
   <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:auto;padding-top:6px">
    <button style="position:relative;display:flex;align-items:center;justify-content:center;min-height:78px;padding:10px 10px;border:3.5px solid var(--ink);border-radius:20px;background:var(--pink-soft);color:var(--ink);box-shadow:0 6px 0 var(--ink);transform:none;opacity:1;font-family:var(--chunky);font-weight:400;font-size:18px;line-height:1.15;text-align:center;word-break:break-word;cursor:pointer;transition:transform 0.08s, box-shadow 0.08s, background 0.15s">
     <span style="position:absolute;left:-6px;top:-9px;display:grid;place-items:center;width:24px;height:24px;border:2.5px solid var(--ink);border-radius:8px;background:var(--pink-soft);color:var(--ink);font-size:12px;transform:rotate(-8deg)">A</span>
     猫
    </button>
    <button style="position:relative;display:flex;align-items:center;justify-content:center;min-height:78px;padding:10px 10px;border:3.5px solid var(--ink);border-radius:20px;background:var(--yellow-soft);color:var(--ink);box-shadow:0 6px 0 var(--ink);transform:none;opacity:1;font-family:var(--chunky);font-weight:400;font-size:18px;line-height:1.15;text-align:center;word-break:break-word;cursor:pointer;transition:transform 0.08s, box-shadow 0.08s, background 0.15s">
     <span style="position:absolute;left:-6px;top:-9px;display:grid;place-items:center;width:24px;height:24px;border:2.5px solid var(--ink);border-radius:8px;background:var(--yellow-soft);color:var(--ink);font-size:12px;transform:rotate(-8deg)">B</span>
     星
    </button>
    <button style="position:relative;display:flex;align-items:center;justify-content:center;min-height:78px;padding:10px 10px;border:3.5px solid var(--ink);border-radius:20px;background:var(--mint-soft);color:var(--ink);box-shadow:0 6px 0 var(--ink);transform:none;opacity:1;font-family:var(--chunky);font-weight:400;font-size:18px;line-height:1.15;text-align:center;word-break:break-word;cursor:pointer;transition:transform 0.08s, box-shadow 0.08s, background 0.15s">
     <span style="position:absolute;left:-6px;top:-9px;display:grid;place-items:center;width:24px;height:24px;border:2.5px solid var(--ink);border-radius:8px;background:var(--mint-soft);color:var(--ink);font-size:12px;transform:rotate(-8deg)">C</span>
     家
    </button>
    <button style="position:relative;display:flex;align-items:center;justify-content:center;min-height:78px;padding:10px 10px;border:3.5px solid var(--ink);border-radius:20px;background:var(--blue-soft);color:var(--ink);box-shadow:0 6px 0 var(--ink);transform:none;opacity:1;font-family:var(--chunky);font-weight:400;font-size:18px;line-height:1.15;text-align:center;word-break:break-word;cursor:pointer;transition:transform 0.08s, box-shadow 0.08s, background 0.15s">
     <span style="position:absolute;left:-6px;top:-9px;display:grid;place-items:center;width:24px;height:24px;border:2.5px solid var(--ink);border-radius:8px;background:var(--blue-soft);color:var(--ink);font-size:12px;transform:rotate(-8deg)">D</span>
     ドラゴン
    </button>
   </div>
  </div>
 </div>
</div>"
`;
