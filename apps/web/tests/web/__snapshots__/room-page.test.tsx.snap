        </div>
        <span aria-hidden="true" style="position:absolute;inset:4px;border:4px solid var(--pink);border-radius:50%;background:rgba(255, 122, 182, 0.22);animation:bingo-stamp 0.45s cubic-bezier(0.3, 1.8, 0.5, 1) both;pointer-events:none"></span>
