// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Emoji Bingo > a game in play, for a player who waits for the host to roll: six emojis called 1`] = `
"queries
  emojiBingo:getActiveEmojiBingo {roomId: "room1"}
  emojiMatch:getActiveEmojiMatch {roomId: "room1"}
  games:getActiveGameSession {roomId: "room1"}
  games:getGameReplay skip
  games:getGameStatus skip
  games:getLatestGameSession {roomId: "room1"}
  games:getMyActiveStep {participantId: "yuki", token: undefined}
  messages:getRoomMessages {roomId: "room1"}
  rooms:getRoomState {roomId: "room1"}
  truthOrDare:getActiveTruthOrDare {roomId: "room1"}
  wordRush:getState {roomId: "room1"}
  wordRush:getState {roomId: "room1"}
mutations
  emojiBingo:cancelGame
  emojiBingo:claimBingo
  emojiBingo:createLobby
  emojiBingo:joinLobby
  emojiBingo:leaveLobby
  emojiBingo:markCell
  emojiBingo:playAgain
  emojiBingo:rollEmoji
  emojiBingo:startGame
  emojiBingo:updateSettings
  emojiMatch:cancelGame
  emojiMatch:createLobby
  emojiMatch:flipCard
  emojiMatch:joinLobby
  emojiMatch:leaveLobby
  emojiMatch:playAgain
  emojiMatch:resolveMismatch
  emojiMatch:startGame
  emojiMatch:timeoutTurn
  games:cancelGame
  games:startGame
  games:submitGameStep
  messages:generateUploadUrl
  messages:sendAudioMessage
  messages:sendDrawingMessage
  messages:sendImageMessage
  messages:sendTextMessage
  participants:setParticipantOnline
  participants:setTypingAction
  participants:updateDisplaySettings
  reactions:addReaction
  reactions:removeReaction
  truthOrDare:advanceTurn
  truthOrDare:createGame
  truthOrDare:endGame
  truthOrDare:skipTurn
  truthOrDare:submitChoice
  truthOrDare:submitRating
  truthOrDare:submitResponse
  wordRush:cancel
  wordRush:createLobby
markup
<div class="ec-room" style="--chat-scale:1;--me-tint:#e8efff">
 <div class="ec-paper" style="--tex-img:url(texture doodles);--tex-size:160px;--blob-a:rgba(255, 122, 182, .18);--blob-b:rgba(59, 107, 255, .13)" aria-hidden="true"></div>
 <header class="ec-chat-head">
  <button aria-label="表示設定" style="flex:none;padding:0;border:0;background:none;cursor:pointer;border-radius:50%">
   <span style="display:inline-grid;place-items:center;flex:none;width:40px;height:40px;border-radius:50%;border:3px solid var(--ink);background:#d9e4ff;box-shadow:0 3px 0 var(--ink);overflow:hidden">
    <img src="/icons/av-cat.png" alt="Cat" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
   </span>
  </button>
  <div class="ec-chat-title">
   <h1>
    <div class="ec-wordmark" style="--fs:22px">
     <div class="ec-logo-top" role="img" aria-label="Enchatto">
      <i data-c="E" style="--r:-7deg;--dy:0px;--d:0s;--i:0;--c:#3b6bff">E</i>
      <i data-c="n" style="--r:6deg;--dy:-5px;--d:-0.18s;--i:1;--c:#ff7ab6">n</i>
      <i data-c="c" style="--r:-7deg;--dy:0px;--d:-0.36s;--i:2;--c:#3fdcb0">c</i>
      <i data-c="h" style="--r:6deg;--dy:-5px;--d:-0.54s;--i:3;--c:#a77bff">h</i>
      <i data-c="a" style="--r:-7deg;--dy:0px;--d:-0.72s;--i:4;--c:#3b6bff">a</i>
      <i data-c="t" style="--r:6deg;--dy:-5px;--d:-0.8999999999999999s;--i:5;--c:#ff7ab6">t</i>
      <i data-c="t" style="--r:-7deg;--dy:0px;--d:-1.08s;--i:6;--c:#3fdcb0">t</i>
      <i data-c="o" style="--r:6deg;--dy:-5px;--d:-1.26s;--i:7;--c:#a77bff">o</i>
     </div>
    </div>
   </h1>
   <span>
    <i class="ec-online-dot"></i>
    3 オンライン
   </span>
  </div>
  <button type="button" class="ec-vibe" aria-expanded="false" aria-label="VIBE 0">
   <small>VIBE</small>
   <b>0</b>
  </button>
  <button class="ec-stack" aria-label="このルームのメンバー 2" aria-haspopup="dialog">
   <span class="ec-stack-av">
    <span style="display:inline-grid;place-items:center;flex:none;width:30px;height:30px;border-radius:50%;border:2.5px solid var(--ink);background:#fde68a;overflow:hidden">
     <img src="/icons/av-hamster.png" alt="Hamster" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
    </span>
    <span class="ec-presence-dot online"></span>
   </span>
   <span class="ec-stack-av">
    <span style="display:inline-grid;place-items:center;flex:none;width:30px;height:30px;border-radius:50%;border:2.5px solid var(--ink);background:#cfe8ff;overflow:hidden">
     <img src="/icons/av-whale.png" alt="Whale" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
    </span>
    <span class="ec-presence-dot online"></span>
   </span>
  </button>
 </header>
 <div class="ec-stage">
  <div class="ec-messages">
   <div class="ec-sys">
    <span style="display:inline-grid;place-items:center;flex:none;width:22px;height:22px;border-radius:50%;border:1.5px solid var(--ink);background:#d9e4ff;overflow:hidden">
     <img src="/icons/av-cat.png" alt="Cat" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
    </span>
    <span>Yukiが参加しました</span>
   </div>
   <div class="ec-sys">
    <span style="display:inline-grid;place-items:center;flex:none;width:22px;height:22px;border-radius:50%;border:1.5px solid var(--ink);background:#cfe8ff;overflow:hidden">
     <img src="/icons/av-whale.png" alt="Whale" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
    </span>
    <span>Samが参加しました</span>
   </div>
   <div class="ec-sys">
    <img src="/icons/g-clover.png" alt="" draggable="false" class="ec-icon" style="width:18px;height:18px"/>
    <span>ゲーム開始：絵文字ビンゴ</span>
   </div>
   <div style="flex:none;height:4px"></div>
  </div>
 </div>
 <div class="ec-inputbar">
  <div class="ec-input-row">
   <div class="ec-tools">
    <button class="ec-round-btn game" aria-label="ゲーム">
     <img src="/icons/ui-game.png" alt="" draggable="false" class="ec-icon" style="width:26px;height:26px"/>
    </button>
    <button class="ec-round-btn draw" aria-label="お絵描き">
     <img src="/icons/g-pencil.png" alt="" draggable="false" class="ec-icon" style="width:24px;height:24px"/>
    </button>
    <button class="ec-round-btn photo" aria-label="写真">
     <img src="/icons/ui-camera.png" alt="" draggable="false" class="ec-icon" style="width:24px;height:24px"/>
    </button>
   </div>
   <input type="file" accept="image/*" style="display:none"/>
   <button type="button" class="ec-tools-toggle" aria-label="ツール" aria-hidden="true" tabindex="-1">
    <svg viewBox="0 0 10 16" aria-hidden="true">
     <path d="M2.5 2l5.5 6-5.5 6"></path>
    </svg>
   </button>
   <div class="ec-text-pill">
    <textarea placeholder="メッセージを入力…" rows="1"></textarea>
   </div>
   <button class="ec-round-btn send" disabled="" aria-label="送信">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
     <path d="M12 20V5" stroke="currentColor" stroke-width="3.4" stroke-linecap="round"></path>
     <path d="M5.5 11.5L12 5l6.5 6.5" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
   </button>
  </div>
 </div>
 <div style="position:fixed;inset:0;z-index:95;display:flex;flex-direction:column;overflow:hidden;background:repeating-linear-gradient(-45deg, rgba(63, 220, 176, 0.1) 0 14px, transparent 14px 28px), var(--paper)">
  <div style="display:flex;flex-direction:column;flex:1;min-height:0;width:100%;max-width:520px;margin:0 auto">
   <div style="display:flex;align-items:center;gap:8px;padding:12px 14px 8px;flex-shrink:0">
    <button class="ec-round-btn" aria-label="最小化" title="最小化" style="width:40px;height:40px;font-size:20px;box-shadow:0 3px 0 var(--ink)">–</button>
    <span class="ec-chunky" style="display:inline-flex;align-items:center;gap:6px;padding:3px 12px 3px 6px;border:2.5px solid var(--ink);border-radius:999px;background:#fff;box-shadow:0 3px 0 var(--ink);font-size:13px;white-space:nowrap">
     <img src="/icons/g-clover.png" alt="" draggable="false" class="ec-icon" style="width:24px;height:24px"/>
     絵文字ビンゴ
    </span>
    <span style="margin-left:auto;font-size:11.5px;font-weight:900;opacity:0.6;white-space:nowrap">6/48 コール済み · ライン</span>
   </div>
   <div style="flex:1;min-height:0;overflow-y:auto;display:flex;flex-direction:column;gap:10px;padding:2px 14px 8px">
    <div class="ec-card" style="display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:22px;box-shadow:0 5px 0 var(--ink);flex-shrink:0">
     <div style="display:grid;place-items:center;flex:none;width:76px;height:76px;border:3.5px solid var(--ink);border-radius:50%;background:radial-gradient(circle at 35% 30%, #fff 0 20%, var(--yellow) 21%);box-shadow:0 5px 0 var(--ink)">
      <img src="/icons/o-sun.png" alt="☀️" draggable="false" class="ec-icon" style="width:52px;height:52px"/>
     </div>
     <div style="flex:1;min-width:0">
      <h3 class="ec-chunky" style="font-size:18px;line-height:1.15;animation:ec-pop 0.4s cubic-bezier(0.3, 1.6, 0.5, 1)">
       Sun! 
       <span style="color:var(--pink)">たいよう！</span>
      </h3>
      <div style="display:flex;align-items:center;gap:5px;margin-top:4px;font-size:12px;font-weight:900">
       <span style="display:inline-grid;place-items:center;flex:none;width:22px;height:22px;border-radius:50%;border:2px solid var(--ink);background:#fde68a;overflow:hidden">
        <img src="/icons/av-hamster.png" alt="Hamster" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
       </span>
       <span style="min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;opacity:0.65">Alex がロール中…</span>
      </div>
      <div style="display:flex;gap:4px;margin-top:6px">
       <span style="display:grid;place-items:center;width:26px;height:26px;border:2px solid var(--ink);border-radius:50%;background:#fff;opacity:1">
        <img src="/icons/o-icecream.png" alt="🍦" draggable="false" class="ec-icon" style="width:19px;height:19px"/>
       </span>
       <span style="display:grid;place-items:center;width:26px;height:26px;border:2px solid var(--ink);border-radius:50%;background:#fff;opacity:0.9">
        <img src="/icons/av-bee.png" alt="🐝" draggable="false" class="ec-icon" style="width:19px;height:19px"/>
       </span>
       <span style="display:grid;place-items:center;width:26px;height:26px;border:2px solid var(--ink);border-radius:50%;background:#fff;opacity:0.8">
        <img src="/icons/o-car.png" alt="🚗" draggable="false" class="ec-icon" style="width:19px;height:19px"/>
       </span>
       <span style="display:grid;place-items:center;width:26px;height:26px;border:2px solid var(--ink);border-radius:50%;background:#fff;opacity:0.7">
        <img src="/icons/o-bread.png" alt="🍞" draggable="false" class="ec-icon" style="width:19px;height:19px"/>
       </span>
       <span style="display:grid;place-items:center;width:26px;height:26px;border:2px solid var(--ink);border-radius:50%;background:#fff;opacity:0.6">
        <img src="/icons/g-bolt.png" alt="⚡" draggable="false" class="ec-icon" style="width:19px;height:19px"/>
       </span>
      </div>
     </div>
    </div>
    <div style="display:flex;gap:6px;overflow-x:auto;flex-shrink:0;padding:2px 0 4px">
     <span style="position:relative;display:inline-flex;align-items:center;gap:4px;flex:none;padding:2px 9px 2px 2px;border:2px solid var(--ink);border-radius:999px;background:#fff;box-shadow:0 2px 0 var(--ink);transform:none;font-size:11.5px;font-weight:900">
      <span style="display:inline-grid;place-items:center;flex:none;width:22px;height:22px;border-radius:50%;border:1.5px solid var(--ink);background:#d9e4ff;overflow:hidden">
       <img src="/icons/av-cat.png" alt="Cat" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
      </span>
      あなた
      <span class="ec-chunky" style="font-size:11px;opacity:0.75">6/25</span>
     </span>
     <span style="position:relative;display:inline-flex;align-items:center;gap:4px;flex:none;padding:2px 9px 2px 2px;border:2px solid var(--ink);border-radius:999px;background:var(--yellow);box-shadow:0 3px 0 var(--ink);transform:translateY(-1px);font-size:11.5px;font-weight:900">
      <span style="display:inline-grid;place-items:center;flex:none;width:22px;height:22px;border-radius:50%;border:1.5px solid var(--ink);background:#fde68a;overflow:hidden">
       <img src="/icons/av-hamster.png" alt="Hamster" draggable="false" style="width:84%;height:84%;object-fit:contain;pointer-events:none"/>
      </span>
      Alex
      <span class="ec-chunky" style="font-size:11px;opacity:0.75">4/25</span>
     </span>
    </div>
    <div style="flex:1 0 auto;display:flex;align-items:flex-start;justify-content:center">
     <div class="ec-card" style="width:min(100%, 440px, max(270px, calc(100dvh - 362px - env(safe-area-inset-bottom))));padding:8px;border-radius:22px;background:var(--blue);box-shadow:0 6px 0 var(--ink)">
      <div class="ec-chunky" style="display:grid;grid-template-columns:repeat(5, 1fr);margin-bottom:4px;color:#fff;font-size:20px;text-align:center;text-shadow:var(--outline2), 0 3px 0 var(--ink)">
       <span>B</span>
       <span>I</span>
       <span>N</span>
       <span>G</span>
       <span>O</span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(5, 1fr);gap:5px">
       <button style="position:relative;aspect-ratio:1;display:grid;place-items:center;padding:0;border:2.5px solid var(--ink);border-radius:12px;background:#fff;box-shadow:0 3px 0 var(--ink);cursor:default;overflow:visible">
        <img src="/icons/o-car.png" alt="🚗" draggable="false" class="ec-icon" style="width:78%;height:78%"/>
        <span aria-hidden="true" style="position:absolute;inset:4px;border:4px solid var(--pink);border-radius:50%;background:rgba(255, 122, 182, 0.22);animation:bingo-stamp 0.45s cubic-bezier(0.3, 1.8, 0.5, 1) both;pointer-events:none"></span>
        <span aria-hidden="true" style="position:absolute;right:-5px;bottom:-5px;display:grid;place-items:center;width:18px;height:18px;border:2px solid var(--ink);border-radius:50%;background:var(--pink);color:#fff;font-size:10px;font-weight:900;line-height:1;animation:ec-pop-in 0.3s 0.15s cubic-bezier(0.3, 1.8, 0.5, 1) both">✓</span>
       </button>
       <button style="position:relative;aspect-ratio:1;display:grid;place-items:center;padding:0;border:2.5px solid var(--ink);border-radius:12px;background:#fff;box-shadow:0 3px 0 var(--ink);cursor:default;overflow:visible">
        <img src="/icons/o-icecream.png" alt="🍦" draggable="false" class="ec-icon" style="width:78%;height:78%"/>
        <span aria-hidden="true" style="position:absolute;inset:4px;border:4px solid var(--pink);border-radius:50%;background:rgba(255, 122, 182, 0.22);animation:bingo-stamp 0.45s cubic-bezier(0.3, 1.8, 0.5, 1) both;pointer-events:none"></span>
        <span aria-hidden="true" style="position:absolute;right:-5px;bottom:-5px;display:grid;place-items:center;width:18px;height:18px;border:2px solid var(--ink);border-radius:50%;background:var(--pink);color:#fff;font-size:10px;font-weight:900;line-height:1;animation:ec-pop-in 0.3s 0.15s cubic-bezier(0.3, 1.8, 0.5, 1) both">✓</span>
       </button>
       <button style="position:relative;aspect-ratio:1;display:grid;place-items:center;padding:0;border:2.5px solid var(--ink);border-radius:12px;background:#fff;box-shadow:0 3px 0 var(--ink);cursor:default;overflow:visible">
        <img src="/icons/o-flower.png" alt="🌸" draggable="false" class="ec-icon" style="width:78%;height:78%"/>
       </button>
       <button style="position:relative;aspect-ratio:1;display:grid;place-items:center;padding:0;border:2.5px solid var(--ink);border-radius:12px;background:#fff;box-shadow:0 3px 0 var(--ink);cursor:default;overflow:visible">
        <img src="/icons/o-cake.png" alt="🍰" draggable="false" class="ec-icon" style="width:78%;height:78%"/>
       </button>
       <button style="position:relative;aspect-ratio:1;display:grid;place-items:center;padding:0;border:2.5px solid var(--ink);border-radius:12px;background:#fff;box-shadow:0 3px 0 var(--ink);cursor:default;overflow:visible">
        <img src="/icons/o-snowman.png" alt="⛄" draggable="false" class="ec-icon" style="width:78%;height:78%"/>
       </button>
       <button style="position:relative;aspect-ratio:1;display:grid;place-items:center;padding:0;border:2.5px solid var(--ink);border-radius:12px;background:#fff;box-shadow:0 3px 0 var(--ink);cursor:default;overflow:visible">
        <img src="/icons/o-watermelon.png" alt="🍉" draggable="false" class="ec-icon" style="width:78%;height:78%"/>
       </button>
       <button style="position:relative;aspect-ratio:1;display:grid;place-items:center;padding:0;border:2.5px solid var(--ink);border-radius:12px;background:#fff;box-shadow:0 3px 0 var(--ink);cursor:default;overflow:visible">
