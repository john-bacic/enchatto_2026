     <button aria-label="#ff4f6d" aria-pressed="false" style="flex:0 1 30px;min-width:0;aspect-ratio:1;border-radius:50%;border:3px solid var(--ink);background:#ff4f6d;box-shadow:0 3px 0 var(--ink);transform:none;transition:transform 0.12s cubic-bezier(0.3, 1.6, 0.5, 1), box-shadow 0.12s"></button>
     <button aria-label="#ff8c42" aria-pressed="false" style="flex:0 1 30px;min-width:0;aspect-ratio:1;border-radius:50%;border:3px solid var(--ink);background:#ff8c42;box-shadow:0 3px 0 var(--ink);transform:none;transition:transform 0.12s cubic-bezier(0.3, 1.6, 0.5, 1), box-shadow 0.12s"></button>
     <button aria-label="#ffd23f" aria-pressed="false" style="flex:0 1 30px;min-width:0;aspect-ratio:1;border-radius:50%;border:3px solid var(--ink);background:#ffd23f;box-shadow:0 3px 0 var(--ink);transform:none;transition:transform 0.12s cubic-bezier(0.3, 1.6, 0.5, 1), box-shadow 0.12s"></button>
     <button aria-label="#3fdcb0" aria-pressed="false" style="flex:0 1 30px;min-width:0;aspect-ratio:1;border-radius:50%;border:3px solid var(--ink);background:#3fdcb0;box-shadow:0 3px 0 var(--ink);transform:none;transition:transform 0.12s cubic-bezier(0.3, 1.6, 0.5, 1), box-shadow 0.12s"></button>
     <button aria-label="#3b6bff" aria-pressed="false" style="flex:0 1 30px;min-width:0;aspect-ratio:1;border-radius:50%;border:3px solid var(--ink);background:#3b6bff;box-shadow:0 3px 0 var(--ink);transform:none;transition:transform 0.12s cubic-bezier(0.3, 1.6, 0.5, 1), box-shadow 0.12s"></button>
     <button aria-label="#a77bff" aria-pressed="false" style="flex:0 1 30px;min-width:0;aspect-ratio:1;border-radius:50%;border:3px solid var(--ink);background:#a77bff;box-shadow:0 3px 0 var(--ink);transform:none;transition:transform 0.12s cubic-bezier(0.3, 1.6, 0.5, 1), box-shadow 0.12s"></button>
     <button aria-label="#ff7ab6" aria-pressed="false" style="flex:0 1 30px;min-width:0;aspect-ratio:1;border-radius:50%;border:3px solid var(--ink);background:#ff7ab6;box-shadow:0 3px 0 var(--ink);transform:none;transition:transform 0.12s cubic-bezier(0.3, 1.6, 0.5, 1), box-shadow 0.12s"></button>
     <button aria-label="#8b5a3c" aria-pressed="false" style="flex:0 1 30px;min-width:0;aspect-ratio:1;border-radius:50%;border:3px solid var(--ink);background:#8b5a3c;box-shadow:0 3px 0 var(--ink);transform:none;transition:transform 0.12s cubic-bezier(0.3, 1.6, 0.5, 1), box-shadow 0.12s"></button>
     <button aria-label="カスタム色" aria-pressed="false" style="position:relative;flex:0 1 30px;min-width:0;aspect-ratio:1;border-radius:50%;border:3px solid var(--ink);background:conic-gradient(#f00, #ff0, #0f0, #0ff, #00f, #f0f, #f00);box-shadow:0 3px 0 var(--ink);transform:none"></button>
    </div>
    <div style="display:flex;align-items:center;gap:8px" aria-label="ペンの太さ">
     <button aria-label="3px" style="display:grid;place-items:center;flex:none;width:34px;height:34px;border-radius:12px;border:2.5px solid var(--ink);background:var(--yellow);box-shadow:0 1px 0 var(--ink);transform:translateY(2px)">
      <span style="width:5px;height:5px;border-radius:50%;background:#1d1b4f;border:none"></span>
     </button>
     <button aria-label="8px" style="display:grid;place-items:center;flex:none;width:34px;height:34px;border-radius:12px;border:2.5px solid var(--ink);background:#fff;box-shadow:0 3px 0 var(--ink);transform:none">
      <span style="width:7.2px;height:7.2px;border-radius:50%;background:#1d1b4f;border:none"></span>
     </button>
     <button aria-label="18px" style="display:grid;place-items:center;flex:none;width:34px;height:34px;border-radius:12px;border:2.5px solid var(--ink);background:#fff;box-shadow:0 3px 0 var(--ink);transform:none">
      <span style="width:16.2px;height:16.2px;border-radius:50%;background:#1d1b4f;border:none"></span>
     </button>
     <div style="height:26px;border-radius:13px;position:relative;cursor:pointer;touch-action:none;border:2.5px solid var(--ink);flex:1;min-width:0;background:#fff">
      <svg aria-hidden="true" viewBox="0 0 100 20" preserveAspectRatio="none" style="position:absolute;inset:3px 12px;width:calc(100% - 24px);height:calc(100% - 6px)">
       <path d="M0 10 L100 2 L100 18 Z" fill="var(--line-soft)"></path>
      </svg>
      <div style="position:absolute;top:50%;left:7.6923076923076925%;transform:translate(-50%, -50%);width:24px;height:24px;border-radius:50%;border:3px solid var(--ink);box-shadow:0 2px 0 var(--ink), inset 0 0 0 2px #fff;pointer-events:none;background:#1d1b4f"></div>
     </div>
    </div>
    <div style="display:flex;align-items:center;gap:10px;padding-top:2px">
     <div style="position:relative;flex:1;min-width:0">
      <span class="drawing-send-pulse" style="position:absolute;inset:0;border-radius:22px;background:var(--blue)"></span>
      <button class="ec-btn" style="position:relative;min-height:58px">
       <span style="display:grid;place-items:center;min-width:34px;height:34px;padding:0 4px;border:2.5px solid var(--ink);border-radius:50%;background:#fff;color:var(--ink);text-shadow:none;font-size:17px">30</span>
       送る
       <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex:none">
        <line x1="12" y1="19" x2="12" y2="5"></line>
        <polyline points="5 12 12 5 19 12"></polyline>
       </svg>
      </button>
      <style>
            .drawing-send-pulse {
              animation: drawingSendPulse 1s ease-out forwards;
              pointer-events: none;
            }
            @keyframes drawingSendPulse {
              0% { transform: scale(1); opacity: 0.45; }
              100% { transform: scale(1.25, 1.6); opacity: 0; }
            }
            /* Under 360px there is no room for Undo&#x27;s label beside Send and its countdown: the arrow alone */
            @media (max-width: 359px) {
              .drawing-undo-label { display: none; }
            }
          </style>
     </div>
     <button class="ec-btn white sm" disabled="" aria-label="戻す" style="width:auto;min-height:58px;padding:0 14px;gap:6px">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
       <path d="M3 10h10a5 5 0 0 1 0 10H12"></path>
       <polyline points="7 14 3 10 7 6"></polyline>
      </svg>
      <span class="drawing-undo-label">戻す</span>
     </button>
    </div>
   </div>
  </div>
 </div>
</div>"
`;

exports[`Lost in Translation > round 2, which Yuki draws > for the host, who waits: Yuki is drawing with twenty-two of the game's thirty seconds left, and the game can be ended 1`] = `
"queries
